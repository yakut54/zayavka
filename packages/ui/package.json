{
  "name": "@app/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "node scripts/axe-stories.mjs",
    "test-storybook:ci": "concurrently -k -s first -n server,axe \"http-server storybook-static -p 6006 --silent\" \"wait-on tcp:6006 && node scripts/axe-stories.mjs http://127.0.0.1:6006\""
  },
  "dependencies": {
    "@app/i18n": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/vue3-vite": "^10.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "axe-core": "^4.10.0",
    "concurrently": "^10.0.6",
    "happy-dom": "^21.0.0",
    "http-server": "^14.1.1",
    "playwright": "^1.50.0",
    "storybook": "^10.0.0",
    "storybook-addon-pseudo-states": "^10.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "^9.5.1"
  }
}

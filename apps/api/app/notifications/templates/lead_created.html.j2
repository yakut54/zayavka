<!doctype html>
<html lang="ru">
  <body style="font-family: Arial, sans-serif; color: #1a1a1a; line-height: 1.5">
    <h2 style="margin: 0 0 16px">Новая заявка № {{ lead.public_number }}</h2>
    <table cellpadding="4" cellspacing="0">
      <tr><td><b>Имя</b></td><td>{{ lead.name }}</td></tr>
      <tr><td><b>Телефон</b></td><td>{{ lead.phone_e164 }}</td></tr>
      {% if lead.email %}<tr><td><b>Email</b></td><td>{{ lead.email }}</td></tr>{% endif %}
      {% if lead.service_title or lead.service_slug %}
      <tr><td><b>Услуга</b></td><td>{{ lead.service_title or lead.service_slug }}</td></tr>
      {% endif %}
      {% if lead.message %}<tr><td valign="top"><b>Сообщение</b></td><td style="white-space: pre-wrap">{{ lead.message }}</td></tr>{% endif %}
    </table>
    <p style="margin-top: 24px">
      <a href="{{ admin_url }}" style="background: #2b59c3; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none">Открыть в админке</a>
    </p>
  </body>
</html>

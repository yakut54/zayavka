{
  "name": "@app/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/make-images.mjs",
    "sync:services": "vite build --outDir node_modules/.cache/sync-services --emptyOutDir",
    "prebuild": "node scripts/make-images.mjs",
    "build": "vite-ssg build",
    "preview": "vite preview --port 4173",
    "budget": "node scripts/check-budget.mjs",
    "typecheck": "vue-tsc --noEmit",
    "pretest": "node scripts/make-images.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@app/api-client": "workspace:*",
    "@app/i18n": "workspace:*",
    "@app/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@unhead/vue": "^2.1.2",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@app/config": "workspace:*",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^21.0.0",
    "sharp": "^0.34.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vite-ssg": "^28.0.0",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.0.0"
  }
}
